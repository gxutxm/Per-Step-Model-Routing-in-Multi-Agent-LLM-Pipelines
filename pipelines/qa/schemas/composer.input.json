{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1
    },
    "question_type": {
      "enum": [
        "bridge",
        "comparison"
      ]
    },
    "hops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "resolved_question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string"
          },
          "found": {
            "type": "boolean"
          },
          "sentences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "resolved_question",
          "answer",
          "found",
          "sentences"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "question",
    "question_type",
    "hops"
  ],
  "additionalProperties": false,
  "title": "qa.composer input"
}
